<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.noear</groupId>
        <artifactId>solon-parent</artifactId>
        <version>4.2.0-SNAPSHOT</version>
        <relativePath />
    </parent>

    <artifactId>soloncode-parent</artifactId>
    <name>${project.artifactId}</name>
    <version>2026.10.20</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <lucene.version>8.11.4</lucene.version>
        <lsp4j.version>0.20.1</lsp4j.version>
        <playwright.version>1.42.0</playwright.version>
        <diff.version>4.16</diff.version>
        <flexmark.version>0.50.50</flexmark.version>
    </properties>

    <!-- 仓库 id 不能叫 sonatype-snapshots：全局 settings.xml 会把该 id 镜像到不含
         org.noear 快照的腾讯镜像，导致 solon-parent 等 SNAPSHOT 无法解析。
         换名后直连 Sonatype 官方快照仓库。 -->
    <repositories>
        <repository>
            <id>sonatype-central-snapshots</id>
            <name>Sonatype Central Snapshots</name>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>daily</updatePolicy>
            </snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>sonatype-central-snapshots</id>
            <name>Sonatype Central Snapshots</name>
            <url>https://central.sonatype.com/repository/maven-snapshots/</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
                <updatePolicy>daily</updatePolicy>
            </snapshots>
        </pluginRepository>
    </pluginRepositories>
</project>